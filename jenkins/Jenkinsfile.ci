pipeline {
  agent { label 'infra-tools' }

  options {
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds(abortPrevious: true)
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    TF_INPUT         = 'false'
    TF_ROOT          = '.'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --oneline'
      }
    }

    stage('Terraform format') {
      when { expression { fileExists("${env.TF_ROOT}/versions.tf") } }
      steps {
        dir("${env.TF_ROOT}") {
          sh 'terraform fmt -check -recursive -diff'
        }
      }
    }

    stage('Terraform validate') {
      when { expression { fileExists("${env.TF_ROOT}/versions.tf") } }
      steps {
        dir("${env.TF_ROOT}") {
          sh 'terraform init -backend=false -input=false'
          sh 'terraform validate -no-color'
        }
      }
    }

    stage('Lint') {
      when { expression { fileExists("${env.TF_ROOT}/versions.tf") } }
      steps {
        dir("${env.TF_ROOT}") {
          sh 'tflint --init'
          sh 'tflint --recursive'
        }
      }
    }

    stage('Security scan') {
      steps {
        sh 'trivy config --exit-code 1 --severity HIGH,CRITICAL .'
      }
    }

    stage('Terraform plan') {
      when { expression { fileExists("${env.TF_ROOT}/versions.tf") } }
      steps {
        dir("${env.TF_ROOT}") {
          sh 'terraform plan -input=false -lock=false -no-color -out=tfplan'
          sh 'terraform show -no-color tfplan > tfplan.txt'
        }
      }
      post {
        always {
          archiveArtifacts artifacts: "${env.TF_ROOT}/tfplan.txt", allowEmptyArchive: true
        }
      }
    }
  }

  post {
    success { echo 'PR validation passed.' }
    failure { echo 'PR validation failed. The pull request must not be merged.' }
    always  { deleteDir() }
  }
}
