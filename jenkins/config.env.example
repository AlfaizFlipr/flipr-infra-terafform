# Jenkins is currently reachable through this local port-forward.
JENKINS_URL=http://127.0.0.1:18080
GITHUB_ORG=fliprlab

# Optional but required to discover/build private repositories and recommended
# even for public repositories because unauthenticated GitHub API limits are low.
# Use a fine-grained token with read access to Contents, Metadata and Pull requests.
GITHUB_TOKEN=

# Internal, HTTP registry service used by the Kubernetes build agents.
REGISTRY=docker-registry.registry.svc.cluster.local:5000
DEPLOY_NAMESPACE=ci-preview

# Poll interval for PR updates and /deploy comments (Jenkins cron syntax).
POLL_SCHEDULE=H/5 * * * *
