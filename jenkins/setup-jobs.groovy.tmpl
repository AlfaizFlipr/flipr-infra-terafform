import com.cloudbees.hudson.plugins.folder.computed.PeriodicFolderTrigger
import jenkins.branch.BranchSource
import jenkins.model.Jenkins
import jenkins.scm.impl.trait.RegexSCMHeadFilterTrait
import org.jenkinsci.plugins.github_branch_source.BranchDiscoveryTrait
import org.jenkinsci.plugins.github_branch_source.ForkPullRequestDiscoveryTrait
import org.jenkinsci.plugins.github_branch_source.GitHubSCMSource
import org.jenkinsci.plugins.github_branch_source.OriginPullRequestDiscoveryTrait
import org.jenkinsci.plugins.github_branch_source.ForkPullRequestDiscoveryTrait.TrustPermission
import org.jenkinsci.plugins.workflow.multibranch.WorkflowBranchProjectFactory
import org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject

def jenkins = Jenkins.get()
def owner = '@@OWNER@@'
def repository = '@@REPOSITORY@@'
def credentialId = '@@CREDENTIAL_ID@@'

def configureJob = { String name, String description, String scriptPath, List traits ->
    def existing = jenkins.getItem(name)
    if (existing != null && !(existing instanceof WorkflowMultiBranchProject)) {
        def backupName = "${name}-backup-${System.currentTimeMillis()}"
        existing.renameTo(backupName)
        println("Renamed existing non-multibranch item ${name} to ${backupName}")
        existing = null
    }

    def job = existing ?: jenkins.createProject(WorkflowMultiBranchProject, name)
    job.setDescription(description)

    def source = new GitHubSCMSource(owner, repository)
    source.setId("${name}-${owner}-${repository}".toString())
    source.setCredentialsId(credentialId)
    source.setTraits(traits)
    job.getSourcesList().replaceBy([new BranchSource(source)])

    def factory = new WorkflowBranchProjectFactory()
    factory.setScriptPath(scriptPath)
    job.setProjectFactory(factory)

    job.getTriggers().values().each { job.removeTrigger(it) }
    job.addTrigger(new PeriodicFolderTrigger('5m'))
    job.save()
    job.scheduleBuild2(0)
    println("Configured ${name} -> ${scriptPath}")
}

configureJob(
    '@@CI_JOB@@',
    'Validates pull requests with Terraform formatting, validation, linting, security scanning, and plan checks. This pipeline never deploys.',
    'jenkins/Jenkinsfile.ci',
    [
        new OriginPullRequestDiscoveryTrait(1),
        new ForkPullRequestDiscoveryTrait(1, new TrustPermission()),
        new RegexSCMHeadFilterTrait('PR-.*')
    ]
)

configureJob(
    '@@DEPLOY_JOB@@',
    'Builds and pushes application images, deploys dev/develop automatically for approved deploy commits, and gates main for production approval.',
    'jenkins/Jenkinsfile.deploy',
    [
        new BranchDiscoveryTrait(1),
        new RegexSCMHeadFilterTrait('(main|dev|develop)')
    ]
)

jenkins.save()
println('Jenkins multibranch pipeline setup completed.')
