pipeline {
  agent { label 'infra-tools' }

  parameters {
    string(name: 'APP_NAME', defaultValue: 'replace-me', description: 'Kubernetes Deployment and container name')
    string(name: 'K8S_NAMESPACE', defaultValue: 'default', description: 'Target Kubernetes namespace')
  }

  options {
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    REGISTRY = 'docker-registry.registry.svc.cluster.local:5000'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHORT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
          env.GIT_MESSAGE = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
        }
      }
    }

    stage('Authorize deployment') {
      steps {
        script {
          if (!(env.GIT_MESSAGE =~ /(?i).*\[deploy\].*/)) {
            error('Deployment requires [deploy] in the merge/commit message.')
          }

          if (env.BRANCH_NAME in ['dev', 'develop']) {
            env.DEPLOY_ENV = 'dev'
          } else if (env.BRANCH_NAME == 'main') {
            env.DEPLOY_ENV = 'prod'
          } else {
            error("Deployment is not allowed from branch ${env.BRANCH_NAME}.")
          }

          env.IMAGE = "${env.REGISTRY}/${params.APP_NAME}:${env.GIT_SHORT_SHA}"
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.DEPLOY_ENV} ${env.GIT_SHORT_SHA}"
        }
      }
    }

    stage('Production approval') {
      when { expression { env.DEPLOY_ENV == 'prod' } }
      input {
        message 'Approve production deployment?'
        ok 'Deploy to production'
        submitter 'infra-admins'
      }
      steps {
        echo 'Production deployment approved.'
      }
    }

    stage('Build and push image') {
      when { expression { fileExists('Dockerfile') } }
      steps {
        sh '''
          test "$APP_NAME" != "replace-me"
          docker build --pull -t "$IMAGE" .
          docker push "$IMAGE"
        '''
      }
    }

    stage('Deploy') {
      steps {
        withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            kubectl -n "$K8S_NAMESPACE" set image \
              "deployment/$APP_NAME" "$APP_NAME=$IMAGE"
            kubectl -n "$K8S_NAMESPACE" rollout status \
              "deployment/$APP_NAME" --timeout=10m
          '''
        }
      }
    }

    stage('Verify') {
      steps {
        withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBECONFIG')]) {
          sh 'kubectl -n "$K8S_NAMESPACE" get deployment,pods,service -l "app=$APP_NAME" -o wide'
        }
      }
    }
  }

  post {
    success { echo "Deployment completed: ${env.IMAGE}" }
    failure { echo 'Deployment failed. Review the failed stage and console log.' }
    always  { deleteDir() }
  }
}
