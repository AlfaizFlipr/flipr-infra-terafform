@Library('ms-jenkins-global-lib') _

/*
 * PR validation entry point. Configure the "PR Validation" GitHub
 * Organization Folder to use this file as its Script Path.
 *
 * The global library annotation is intentional: repositories can replace the
 * shell steps below with approved library steps without changing job setup.
 */
pipeline {
  agent { label 'terraform-ci' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    TF_INPUT         = 'false'
    // Change this to the endpoint reachable from Jenkins build agents.
    TEST_DEPLOY_JOB  = 'Test Deploy'
  }

  stages {
    stage('PR context') {
      steps {
        script {
          if (!env.CHANGE_ID) {
            error('This job is PR-only. Enable only Pull request discovery in the Organization Folder.')
          }
        }
        checkout scm
        sh 'git log -1 --format="commit=%H%nsubject=%s"'
      }
    }

    stage('Formatting') {
      steps { sh 'terraform fmt -check -diff -recursive' }
    }

    stage('Terraform validation') {
      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail
          terraform init -backend=false -input=false
          terraform validate -no-color
        '''
      }
    }

    stage('Lint') {
      steps { sh 'tflint --init && tflint --recursive --format compact' }
    }

    stage('Security') {
      parallel {
        stage('IaC scan') {
          steps { sh 'trivy config --exit-code 1 --severity HIGH,CRITICAL .' }
        }
        stage('Secrets scan') {
          steps { sh 'gitleaks detect --source . --no-banner --redact' }
        }
      }
    }

    stage('Terraform plan') {
      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail
          set +e
          terraform plan -input=false -lock=false -detailed-exitcode -out=tfplan
          status=$?
          set -e
          # 0 means no diff; 2 means a valid diff. Both are successful PR plans.
          test "$status" -eq 0 -o "$status" -eq 2
          terraform show -no-color tfplan > terraform-plan.txt
        '''
      }
      post {
        always { archiveArtifacts artifacts: 'terraform-plan.txt', allowEmptyArchive: true }
      }
    }
  }

  post {
    success {
      script {
        def deployRequested = sh(
          returnStatus: true,
          script: '''#!/usr/bin/env bash
            set -Eeuo pipefail
            # Exact, case-insensitive commit subject prevents accidental deploys.
            git log "origin/${CHANGE_TARGET}..HEAD" --format=%s | grep -Eix 'deploy'
          '''
        ) == 0

        if (deployRequested) {
          // The downstream folder is scanned from the same GitHub organization.
          // Its full job path is Test Deploy/<repository>/<PR-number>.
          def discoveredJob = env.JOB_NAME.tokenize('/').drop(1).join('/')
          build job: "${env.TEST_DEPLOY_JOB}/${discoveredJob}",
                parameters: [string(name: 'UPSTREAM_BUILD_URL', value: env.BUILD_URL)],
                wait: false, propagate: false
        } else {
          echo 'No exact "deploy" commit subject in this PR; test deployment is not requested.'
        }
      }
    }
    failure {
      echo 'PR validation failed. GitHub should receive a failed required check from this job.'
    }
  }
}
