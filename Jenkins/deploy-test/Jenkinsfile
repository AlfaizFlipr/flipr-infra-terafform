@Library('ms-jenkins-global-lib') _

/* Configure the "Test Deploy" GitHub Organization Folder to use this file. */
pipeline {
  agent { label 'kubernetes-ci' }

  parameters {
    string(name: 'UPSTREAM_BUILD_URL', defaultValue: '', description: 'Set only by PR Validation.')
    booleanParam(name: 'DEPLOY_PRODUCTION', defaultValue: false, description: 'Production requires an additional approval gate.')
  }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    // K3s-internal registry address; override globally if agents are external.
    TEST_REGISTRY = 'docker-registry.registry.svc.cluster.local:5000'
    IMAGE_NAME    = 'terraform-pr-test'
  }

  stages {
    stage('Deployment request') {
      when { beforeAgent true; expression { return params.UPSTREAM_BUILD_URL?.trim() } }
      steps {
        script {
          if (!env.CHANGE_ID) { error('A downstream test deployment must target a PR.') }
        }
        checkout scm
        sh 'git log -1 --format="commit=%H%nsubject=%s"'
      }
    }

    stage('Build and push test image') {
      when { beforeAgent true; expression { return params.UPSTREAM_BUILD_URL?.trim() } }
      steps {
        sh '''#!/usr/bin/env bash
          set -Eeuo pipefail
          command -v docker >/dev/null
          tag="pr-${CHANGE_ID}-${GIT_COMMIT:0:12}"
          docker build -f Jenkins/deploy-test/Dockerfile.ci -t "${TEST_REGISTRY}/${IMAGE_NAME}:${tag}" .
          docker push "${TEST_REGISTRY}/${IMAGE_NAME}:${tag}"
          printf '%s' "${TEST_REGISTRY}/${IMAGE_NAME}:${tag}" > test-image.txt
        '''
      }
    }

    stage('Test smoke check') {
      when { beforeAgent true; expression { return params.UPSTREAM_BUILD_URL?.trim() } }
      steps { sh 'Jenkins/deploy-test/scripts/smoke-test.sh test-image.txt' }
    }

    stage('Production gate') {
      when { expression { return params.UPSTREAM_BUILD_URL?.trim() && env.BRANCH_NAME == 'main' && params.DEPLOY_PRODUCTION == true } }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: 'Approve production deployment?', ok: 'Deploy production', submitter: 'jenkins-prod-approvers'
        }
        sh 'echo "Production deployment goes here; use a separate production registry and immutable image digest."'
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'test-image.txt', allowEmptyArchive: true
      junit allowEmptyResults: true, testResults: 'test-results/**/*.xml'
    }
    success {
      script {
        if (params.UPSTREAM_BUILD_URL?.trim()) {
          echo "Test image published successfully. Upstream validation: ${params.UPSTREAM_BUILD_URL}"
        } else {
          echo 'Skipped: only the successful PR Validation pipeline may request a test deployment.'
        }
      }
    }
    failure { echo 'Test deploy failed; inspect the stage log and archived artifacts above.' }
  }
}
